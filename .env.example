# Open-source Postgres (Neon, self-hosted, or local Docker).
# Local: docker compose up -d  →  postgresql://postgres:postgres@localhost:5432/flipcast
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flipcast
# Production example (Neon): postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/flipcast?sslmode=require

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:3000
