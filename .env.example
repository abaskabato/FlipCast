# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres (local Docker, Neon, or any hosted provider).
# Local: docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flipcast
# Production: Neon (recommended) or any Postgres. Use the POOLED endpoint on
# serverless - a direct connection will exhaust Postgres' connection limit
# under concurrent requests. See src/db/index.ts.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/flipcast?sslmode=require
# DATABASE_URL_POOLED=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/flipcast?sslmode=require

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# MUST be set in production. A weak or missing secret lets anyone forge a
# session cookie. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret

# Canonical public URL. Used for password-reset links and as the primary
# trusted origin.
BETTER_AUTH_URL=http://localhost:3000

# Extra origins allowed to authenticate, comma separated. No wildcards.
# Needed for local dev on other ports (3000/3100/3001/5173 and their
# 127.0.0.1 equivalents are always allowed) and for Vercel preview hostnames,
# which are not derivable from the env vars Vercel exposes.
# AUTH_TRUSTED_ORIGINS=https://flipcast.app,https://flipcast-git-main.vercel.app

# ---------------------------------------------------------------------------
# Transactional email (optional)
# ---------------------------------------------------------------------------
# Without these, password-reset emails are logged to stdout in development
# and dropped in production. Sign-up and sign-in do not require email.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# AUTH_EMAIL_FROM="Flipcast <noreply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Billing (optional — free tier works without any of this)
# ---------------------------------------------------------------------------
# With no STRIPE_SECRET_KEY the app is fully functional on the free tier and
# POST /api/billing/checkout returns 503 with a readable reason. Nothing
# degrades: quota, rendering and auth are unaffected.
#
# To enable paid plans:
#   1. Create two recurring prices in the Stripe dashboard (Creator, Agency),
#      monthly and yearly.
#   2. Set the key and the four price IDs below.
#   3. Point a webhook at https://<your-domain>/api/billing/webhook, subscribed
#      to: checkout.session.completed, customer.subscription.created,
#      customer.subscription.updated, customer.subscription.deleted.
#   4. Copy the signing secret into STRIPE_WEBHOOK_SECRET.
#
# The webhook is the only writer of user.subscription_tier. Do not set the tier
# from the client or a plan could be bypassed from devtools.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CREATOR_MONTHLY=price_...
# STRIPE_PRICE_CREATOR_YEARLY=price_...
# STRIPE_PRICE_AGENCY_MONTHLY=price_...
# STRIPE_PRICE_AGENCY_YEARLY=price_...